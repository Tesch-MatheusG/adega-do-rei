# Porta em que a API sobe localmente (o Render define a dele automaticamente)
PORT=3000

# Conexão com o MySQL
# Local: dados do seu MySQL instalado na máquina.
# Aiven: host/porta/usuário/senha/nome do banco do painel do serviço Aiven.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adega_do_rei
DB_USER=root
DB_PASSWORD=

# SSL do banco — necessário para a Aiven, não necessário para MySQL local.
# DB_SSL=true liga a conexão criptografada.
# DB_SSL_CA_PATH (opcional) aponta para o certificado ca.pem baixado no painel
# da Aiven, para validar o certificado de verdade. Sem ele, a conexão ainda é
# criptografada, só não valida a cadeia do certificado.
DB_SSL=false
DB_SSL_CA_PATH=

# Autenticação
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_EXPIRES_IN=1d

# Usado apenas pelo script "npm run seed:admin" (cria a conta de administrador)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@adegadorei.com
ADMIN_SENHA=Admin@1234

# URL(s) do frontend autorizada(s) a chamar a API (separe por vírgula se for mais de uma)
CORS_ORIGIN=http://localhost:5173
