# Banco (Aiven MySQL) - copie do painel do serviço
DB_HOST=seu-servico.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
# Na Aiven: DB_SSL=true. No seu MySQL local: DB_SSL=false (e DB_HOST=localhost, DB_PORT=3306).
DB_SSL=true
# Certificado (opcional, recomendado). Use UMA das duas formas:
#  DB_SSL_CA_PATH = caminho do arquivo ca.pem (máquina local)
#  DB_SSL_CA      = conteúdo do ca.pem colado em uma linha, com \n no lugar das quebras (Render)
DB_SSL_CA_PATH=
DB_SSL_CA=

# Reservas: de quantos em quantos minutos o servidor expira reservas vencidas (padrão 10)
EXPIRACAO_INTERVALO_MIN=10

# Autenticação
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=2h

# URL(s) do frontend, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Usado apenas pelo npm run seed:admin
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=